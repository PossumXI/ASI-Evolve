"""Route policy for the Immaculate router: which candidate should serve a cell of work first.

ASI-Evolve evolves this file. evaluator.py imports it and calls rank_candidates once per cell (a TaskClass
and ComplexityBand pair, plus the catch-all cell "*|*"). The ranking it returns is compiled into a route
order table; the program itself never runs inside the gateway.

Inputs
  cell    {"task_class": str, "complexity": str}; "*" in both fields for the catch-all cell.
  stats   per-candidate means over the FIT fold of measured outcomes:
            stats["global"][candidate]
            stats["by_class"][task_class][candidate]
            stats["by_cell"]["<task_class>|<complexity>"][candidate]
          each {"n": int, "performance": float in [0, 1], "cost_usd": float, "latency_s": float | None}.
  params  {"lambda_cost": float, "cost_reference_usd": float}. Fitness per query is
          performance - lambda_cost * cost_usd / cost_reference_usd for the candidate that serves it.

Output
  A list of candidate names, best first. Unknown names or duplicates fail the evaluation; any candidate
  left out is appended in global-utility order.

Baseline: estimate each candidate's utility in the cell, shrunk toward its class-level (then global)
utility in proportion to how few fit samples the cell has, and rank by that estimate.
"""

PRIOR_STRENGTH = 20.0


def _utility(summary, params):
    return summary["performance"] - params["lambda_cost"] * summary["cost_usd"] / params["cost_reference_usd"]


def rank_candidates(cell, stats, params):
    cell_key = f"{cell['task_class']}|{cell['complexity']}"
    cell_stats = stats["by_cell"].get(cell_key, {})
    class_stats = stats["by_class"].get(cell["task_class"], {})
    scored = []
    for name, global_summary in stats["global"].items():
        prior = _utility(class_stats[name], params) if name in class_stats else _utility(global_summary, params)
        in_cell = cell_stats.get(name)
        if in_cell:
            estimate = (in_cell["n"] * _utility(in_cell, params) + PRIOR_STRENGTH * prior) / (in_cell["n"] + PRIOR_STRENGTH)
        else:
            estimate = prior
        scored.append((estimate, name))
    scored.sort(key=lambda item: (-item[0], item[1]))
    return [name for _, name in scored]
