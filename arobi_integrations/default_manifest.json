    "sourceIndex": "<root:website>/index.html",
    "artifactRoot": "<root:website>/dist",
    "forbiddenDeployRoots": [
      "<root:website>/aura-genesis.org",
      "<filesystem-root>",
      "<root:openjaws>",
      "<root:immaculate>",
      "${AROBI_EVOLVE_LEGACY_ASGARD_ROOT}"
    ]
  },
  "endpoints": {
    "qGatewayHealth": "${IMMACULATE_Q_GATEWAY_URL:-http://127.0.0.1:8897}/health"
  },
  "analytics": {
