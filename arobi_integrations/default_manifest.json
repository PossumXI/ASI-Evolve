    "immaculate": "${AROBI_EVOLVE_ROOT_IMMACULATE:-../Immaculate}",
    "openjaws": "${AROBI_EVOLVE_ROOT_OPENJAWS:-../OpenJaws}"
  },
  "operatorStateDirs": {
