    "arobiPublic": "${AROBI_EVOLVE_AROBI_PUBLIC_HOME:-~/.arobi-public}",
    "arobiRailway": "${AROBI_EVOLVE_AROBI_RAILWAY_HOME:-~/.arobi-railway}",
    "cloudflared": "${AROBI_EVOLVE_CLOUDFLARED_HOME:-~/.cloudflared}"
  },
  "website": {
