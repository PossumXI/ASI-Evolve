  "automation": {
    "pollIntervalSeconds": 900,
    "analyticsWindowDays": 7,
    "notifyFounderOn": [
      "new route or service failures",
      "route or service recoveries",
      "analytics deltas from the configured analytics source",
      "tasks newly held for signed approval"
    ],
    "autonomousActionsAllowed": [
      "read-only production health checks",
      "read-only operator analytics through the auth-gated Asgard API",
      "direct Supabase/Stripe reads only when the direct fallback is explicitly enabled",
      "local safe recovery commands for Q gateway and approved local services",
      "Discord founder notifications without secrets or customer PII",
      "signed delivery of approved tasks to Immaculate's governed ASI intake"
    ],
    "approvalStillRequired": [
      "production deploys",
      "external outreach email, post, DM, comment, or calendar send",
      "billing mutation, refund, discount creation, or subscription change",
      "database schema migration or RLS policy mutation",
      "credential, role, invite, firewall, Cloudflare, OCI, or Railway mutation"
    ]
  },
  "recoveryCommands": {
    "superbrain-health": [
      {
        "id": "start-immaculate-harness-supervisor",
        "platforms": ["windows"],
        "cwd": "<root:openjaws>/local-command-station",
        "argv": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Start-Process -FilePath powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File','<root:openjaws>\\local-command-station\\start-immaculate-harness.ps1') -WorkingDirectory '<root:openjaws>\\local-command-station' -WindowStyle Hidden"
        ],
        "timeoutSec": 30
      },
      {
        "id": "start-immaculate-harness-detached",
        "platforms": ["posix"],
        "cwd": "<root:immaculate>",
        "argv": ["sh", "-c", "nohup npm run harness:serve >> \"$0\" 2>&1 &", "<state>/logs/immaculate-harness.log"],
        "timeoutSec": 30
      }
    ],
    "immaculate-local-harness": [
      {
        "id": "start-immaculate-harness-supervisor",
        "platforms": ["windows"],
        "cwd": "<root:openjaws>/local-command-station",
        "argv": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Start-Process -FilePath powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File','<root:openjaws>\\local-command-station\\start-immaculate-harness.ps1') -WorkingDirectory '<root:openjaws>\\local-command-station' -WindowStyle Hidden"
        ],
        "timeoutSec": 30
      },
      {
        "id": "start-immaculate-harness-detached",
        "platforms": ["posix"],
        "cwd": "<root:immaculate>",
        "argv": ["sh", "-c", "nohup npm run harness:serve >> \"$0\" 2>&1 &", "<state>/logs/immaculate-harness.log"],
        "timeoutSec": 30
      }
    ],
    "q-gateway-local": [
      {
        "id": "start-q-gateway-hidden",
        "platforms": ["windows"],
        "cwd": "<root:immaculate>",
        "argv": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Start-Process -FilePath npm.cmd -ArgumentList @('run','q:gateway') -WorkingDirectory '<root:immaculate>' -WindowStyle Hidden"
        ],
        "timeoutSec": 30
      },
      {
        "id": "start-q-gateway-detached",
        "platforms": ["posix"],
        "cwd": "<root:immaculate>",
        "argv": ["sh", "-c", "nohup npm run q:gateway >> \"$0\" 2>&1 &", "<state>/logs/q-gateway.log"],
        "timeoutSec": 30
      }
    ],
    "discord-bridge": [
      {
        "id": "start-discord-q-direct",
        "platforms": ["windows"],
        "cwd": "<root:openjaws>/local-command-station",
        "argv": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "<root:openjaws>\\local-command-station\\start-discord-q-direct.ps1",
          "-EnvFile",
          "<root:openjaws>\\local-command-station\\discord-q-agent.env.ps1",
          "-AgentLabel",
          "Q",
          "-StartupTimeoutSeconds",
          "150"
        ],
        "timeoutSec": 180
      }
    ],
    "linkedin-bridge": [
      {
        "id": "start-linkedin-bridge",
        "platforms": ["windows"],
        "cwd": "<root:openjaws>/local-command-station",
        "argv": [
          "powershell",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "<root:openjaws>\\local-command-station\\start-linkedin-bridge.ps1"
        ],
        "timeoutSec": 240
      }
    ]
